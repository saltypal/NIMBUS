# Local core configuration. Copy to .env; credentials are never committed.
NIMBUS_STORAGE_BACKEND=mongo
NIMBUS_MONGO_URI=mongodb://127.0.0.1:27017
NIMBUS_DATABASE=nimbus
NIMBUS_DEMO_MODE=true
NIMBUS_INFERENCE_ENABLED=false
NIMBUS_RETRIEVAL_BACKEND=lexical

# Use three different random keys. Keep MongoDB and app port 8000 local.
NIMBUS_BRIDGE_SPEECH_KEY=6969
NIMBUS_BRIDGE_HANDWRITING_KEY=6868
NIMBUS_BRIDGE_LLM_KEY=6767
NIMBUS_JOB_LEASE_SECONDS=60
NIMBUS_JOB_MAX_RUNTIME_SECONDS=600
